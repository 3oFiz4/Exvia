<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- Target file indicator (determined by default file config) -->
    <TextView
        android:id="@+id/widget_target_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="--> expenses.json"
        android:textColor="#CBD5E1"
        android:textSize="13sp" />

    <!-- Scrollable ListView containing all possible fields from Exvia default file -->
    <ListView
        android:id="@+id/widget_fields_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="vertical" />

    <!-- Empty view fallback -->
    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="No fields available"
        android:textColor="#7D7D7D"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Native Amend button -->
    <Button
        android:id="@+id/widget_btn_amend"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/selector_widget_button"
        android:fontFamily="monospace"
        android:text="Amend"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Status log line -->
    <TextView
        android:id="@+id/widget_log_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:text="log: Ready"
        android:textColor="#86EFAC"
        android:textSize="12sp" />

</LinearLayout>
